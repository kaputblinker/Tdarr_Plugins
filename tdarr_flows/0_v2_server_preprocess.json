    {
      "name": "Lookup target bitrate for resolution",
      "sourceRepo": "Community",
      "pluginName": "customFunction",
      "version": "1.0.0",
      "id": "Qb3DSpeol",
      "position": {
        "x": 672,
        "y": 60
      },
      "fpEnabled": true,
      "inputsDB": {
        "code": "module.exports = async (args) => {\n    // Use the caller-provided normalized resolution label directly.\n    const resolutionLabel = String(args.inputFileObj?.video_resolution || '').trim();\n\n    if (!resolutionLabel) {\n        throw new Error('Missing args.inputFileObj.video_resolution');\n    }\n\n    // Derived via a combination of me looking at past results and me making stuff up.\n    // These are somewhat generous to try and make sure that even more visually complex stuff, will be around this.\n    // There are ofc very complex exceptions that get transcoded for very little benefit. Mainly Avatar 3. That thing is bananas.\n    const bitrateLookupKbps = {\n        '480p': 900,\n        '576p': 1200,\n        '720p': 2000,\n        '1080p': 3100,\n        '1440p': 5000,\n        '4KUHD': 7500,\n        'DCI4K': 10000,\n        '8KUHD': 12500\n    };\n\n    const targetBitrateKbps = bitrateLookupKbps[resolutionLabel];\n\n    if (!targetBitrateKbps) {\n        const valid = Object.keys(bitrateLookupKbps).join(', ');\n        throw new Error(\n            'Unsupported video_resolution \"' +\n            resolutionLabel +\n            '\". Expected one of: ' +\n            valid\n        );\n    }\n\n    const transcodeFailoutTime = {\n        '480p': 60,\n        '576p': 60,\n        '720p': 100,\n        '1080p': 200,\n        '1440p': 200,\n        '4KUHD': 240,\n        'DCI4K': 240,\n        '8KUHD': 240\n    }; // I love that the live transcode plugin delay is based on real time instead of video time!\n    \n    // Set flow variables for downstream steps.\n    args.variables = args.variables || {};\n    args.variables.targetBitrateKbps = targetBitrateKbps;\n    // We want the threshold to be aggressive. If it can't be compressed very well, this will be detected during transcode\n    args.variables.videoTranscodeThresholdKps = targetBitrateKbps * 0.8; \n    args.variables.overallBitrateThresholdKps = targetBitrateKbps * 0.9;\n    args.variables.maxBitrate4x = String(targetBitrateKbps * 4) + 'k';\n    args.variables.maxBitrate8x = String(targetBitrateKbps * 8) + 'k';\n    args.variables.transcodeFailoutTime = transcodeFailoutTime[resolutionLabel];\n\n    args.jobLog(\n        'lookupMaxBitrate: resolution=' +\n        resolutionLabel +\n        ', target=' +\n        targetBitrateKbps +\n        'k, threshold=' +\n        args.variables.videoTranscodeThresholdKps +\n        'k, max4x=' +\n        args.variables.maxBitrate4x +\n        'k, max8x=' +\n        args.variables.maxBitrate8x +\n        'k, failoutTime=' +\n        args.variables.transcodeFailoutTime\n    );\n\n    return {\n        outputFileObj: args.inputFileObj,\n        outputNumber: 1,\n        variables: args.variables\n    };\n};"
      }
    },
